{
  "name": "soliditylings",
  "version": "2.0.0",
  "description": "Small exercises to get you used to writing and reading Solidity code — a Rustlings-style trainer for Ethereum smart contract developers, powered by Foundry.",
  "main": "dist/index.js",
  "bin": {
    "soliditylings": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "solidity",
    "ethereum",
    "foundry",
    "learning",
    "exercises",
    "rustlings"
  ],
  "author": "BradMyrick",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "smol-toml": "^1.9.1"
  }
}
